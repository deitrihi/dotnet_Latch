@* 공통 레이아웃: 상단 바와 본문 영역 *@
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Latch" : "Latch")</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="brand" href="/">Latch</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page="/Logout"><button class="link">로그아웃</button></form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
